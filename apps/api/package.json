{
  "name": "@mgx/api",
  "version": "0.1.0",
  "private": true,
  "description": "API MG-Exchange — monolithe modulaire NestJS.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm run db:generate",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "prestart:dev": "pnpm run db:generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "openapi:export": "UPDATE_OPENAPI=1 pnpm run test:e2e environments"
  },
  "dependencies": {
    "@mgx/contracts": "workspace:*",
    "@mgx/shared": "workspace:*",
    "@mgx/validation": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@mgx/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "pg": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
