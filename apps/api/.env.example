# Configuration de l'API MG-Exchange — développement local.
# Copier vers `.env` (jamais versionné). Aucun secret réel ne doit figurer dans ce fichier.
# Toutes les variables sont validées au démarrage (apps/api/src/config/env.schema.ts) :
# une valeur absente ou invalide empêche le lancement.

# --- Application ---------------------------------------------------------------------------
NODE_ENV=development
# local | development | staging | production | test
APP_ENV=local
HOST=0.0.0.0
PORT=3000
# Nombre de proxys de confiance devant l'API : 0 en accès direct, 1 derrière Nginx.
TRUST_PROXY_HOPS=0

# --- HTTP ----------------------------------------------------------------------------------
# Origines autorisées (séparées par des virgules). Vide = aucune requête inter-origines.
CORS_ALLOWED_ORIGINS=http://localhost:3001
HTTP_BODY_LIMIT_BYTES=102400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- Journalisation ------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Mise en forme lisible dans un terminal (interdite en staging et en production).
LOG_PRETTY=true

# --- PostgreSQL ----------------------------------------------------------------------------
# Rôle applicatif (lecture/écriture des données uniquement). Remplacer <...> par les valeurs
# du fichier `.env` racine utilisé par Docker Compose.
DATABASE_URL=postgresql://mgx_app:<MGX_DB_APP_PASSWORD>@localhost:5432/mgx
# Rôle propriétaire du schéma — lu uniquement par la CLI Prisma (migrations), jamais par l'API.
DATABASE_MIGRATION_URL=postgresql://mgx_owner:<MGX_DB_OWNER_PASSWORD>@localhost:5432/mgx
# Base « fantôme » jetable, distincte de la base principale — lue uniquement par la CLI Prisma,
# qui la vide puis y rejoue les migrations (`pnpm db:check-drift`, `prisma migrate dev`).
# Docker Compose la crée au premier démarrage : <MGX_DB_NAME>_shadow.
SHADOW_DATABASE_URL=postgresql://mgx_owner:<MGX_DB_OWNER_PASSWORD>@localhost:5432/mgx_shadow
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis ---------------------------------------------------------------------------------
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
# Redis dédié aux files BullMQ (politique noeviction). Vide = REDIS_URL.
QUEUE_REDIS_URL=

# --- Documentation OpenAPI -----------------------------------------------------------------
# Par défaut : servie en local/development/test, jamais ailleurs. Interdite en production.
# En staging, exige SWAGGER_USER et SWAGGER_PASSWORD (12 caractères minimum).
SWAGGER_ENABLED=
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Boîte d'envoi transactionnelle --------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# --- Tests d'intégration et de bout en bout ------------------------------------------------
# Superutilisateur d'un PostgreSQL 18 JETABLE : le harnais y crée rôles et bases de test.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:<POSTGRES_SUPERUSER_PASSWORD>@localhost:5432/postgres
# TEST_REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/15
