{
  "name": "mg-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "MG-Exchange — plateforme fintech (API, web, mobile, back-office). Monorepo pnpm.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter @mgx/api run test:integration",
    "test:e2e": "pnpm --filter @mgx/api run test:e2e",
    "db:generate": "pnpm --filter @mgx/api run db:generate",
    "db:migrate:dev": "pnpm --filter @mgx/api run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @mgx/api run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @mgx/api run db:migrate:status",
    "db:check-drift": "pnpm --filter @mgx/api run db:check-drift",
    "dev:api": "pnpm --filter @mgx/api run start:dev",
    "admin:create": "pnpm --filter @mgx/api run cli admin:create",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@mgx/config": "workspace:*",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
