# Variables de Docker Compose — infrastructure locale (PostgreSQL, Redis, et en option l'API
# conteneurisée derrière Nginx). Copier vers `.env` (jamais versionné).
#
# Générer chaque mot de passe avec :  openssl rand -hex 24
# (caractères hexadécimaux uniquement : ces valeurs sont insérées dans des URL de connexion)

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
MGX_DB_NAME=mgx
# Rôle propriétaire du schéma : exécute les migrations.
MGX_DB_OWNER_USER=mgx_owner
MGX_DB_OWNER_PASSWORD=
# Rôle applicatif : utilisé par l'API (données uniquement, aucun DDL).
MGX_DB_APP_USER=mgx_app
MGX_DB_APP_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379

# --- API -----------------------------------------------------------------------------------
# Clé du HMAC des codes à usage unique envoyés aux utilisateurs.  Générer : openssl rand -hex 32
AUTH_CODE_HMAC_SECRET=
# Clé de chiffrement des secrets de la validation en deux étapes (32 octets en base64).
# Générer : openssl rand -base64 32      — à sauvegarder : la perdre désactive tous les seconds facteurs.
AUTH_SECRETS_ENCRYPTION_KEY=

# Envoi réel des e-mails (facultatif). Sans SMTP_HOST, les messages restent dans la boîte de
# réception de développement. Détail des variables : apps/api/.env.example.
SMTP_HOST=
SMTP_SECURITY=starttls
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Vérification d'identité (facultatif). Définir cette clé rend la vérification utilisable : les
# pièces sont alors conservées, chiffrées, dans le volume `kyc-documents` de l'API. Sans elle,
# les routes de vérification répondent « indisponible ».
# Générer : openssl rand -base64 32      — distincte de AUTH_SECRETS_ENCRYPTION_KEY.
# À SAUVEGARDER, séparément du volume : la perdre rend toutes les pièces illisibles.
KYC_ENCRYPTION_KEY=

# --- Profil « app » (API conteneurisée derrière Nginx) --------------------------------------
# local | development | staging   (la production ne se déploie pas avec ce fichier)
APP_ENV=local
# Port d'écoute de Nginx sur la machine hôte.
HTTP_PORT=8080
