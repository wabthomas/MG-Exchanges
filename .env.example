# Variables de Docker Compose — infrastructure locale (PostgreSQL, Redis, et en option l'API
# conteneurisée derrière Nginx). Copier vers `.env` (jamais versionné).
#
# Générer chaque mot de passe avec :  openssl rand -hex 24
# (caractères hexadécimaux uniquement : ces valeurs sont insérées dans des URL de connexion)

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
MGX_DB_NAME=mgx
# Rôle propriétaire du schéma : exécute les migrations.
MGX_DB_OWNER_USER=mgx_owner
MGX_DB_OWNER_PASSWORD=
# Rôle applicatif : utilisé par l'API (données uniquement, aucun DDL).
MGX_DB_APP_USER=mgx_app
MGX_DB_APP_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Profil « app » (API conteneurisée derrière Nginx) --------------------------------------
# local | development | staging   (la production ne se déploie pas avec ce fichier)
APP_ENV=local
# Port d'écoute de Nginx sur la machine hôte.
HTTP_PORT=8080
